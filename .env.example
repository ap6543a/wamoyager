WMATA_API_KEY=your_key_here

# Mailgun SMTP — find credentials in Mailgun dashboard under
# Sending → Domain Settings → SMTP credentials
MAILGUN_SMTP_LOGIN=XXXXX
MAILGUN_SMTP_PASSWORD=XXXXX
MAILGUN_FROM_ADDRESS=XXXXX
MAILGUN_FROM_NAME=XXXXX

DATABASE_PATH=./wamoyager.db
DRY_RUN=true
POLL_INTERVAL_SECONDS=120
DAILY_JOB_TIME=17:00
RATE_LIMIT_MAX_PER_HOUR=3
COOLDOWN_MINUTES=30
LOG_LEVEL=INFO

# Inbound SMS webhook (future use — requires SMS provider)
WEBHOOK_ENABLED=false
WEBHOOK_PORT=8080

# OpenAI (required for AgentsSdkBrain — not needed for StubBrain)
OPENAI_API_KEY=sk-xxxxxxxx
