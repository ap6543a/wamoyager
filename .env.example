WMATA_API_KEY=your_key_here

# Gmail — use an App Password, not your normal password
# Google Account → Security → 2-Step Verification → App Passwords
GMAIL_ADDRESS=yourapp@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_FROM_NAME=Wamoyager

DATABASE_PATH=./wamoyager.db
DRY_RUN=true
POLL_INTERVAL_SECONDS=120
DAILY_JOB_TIME=17:00
RATE_LIMIT_MAX_PER_HOUR=3
COOLDOWN_MINUTES=30
LOG_LEVEL=INFO

# Inbound SMS webhook (future use — requires SMS provider)
WEBHOOK_ENABLED=false
WEBHOOK_PORT=8080

# OpenAI (required for AgentsSdkBrain — not needed for StubBrain)
OPENAI_API_KEY=sk-xxxxxxxx
