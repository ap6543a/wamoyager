WMATA_API_KEY=your_key_here
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
DATABASE_PATH=./wamoyager.db
DRY_RUN=true
POLL_INTERVAL_SECONDS=120
DAILY_JOB_TIME=17:00
RATE_LIMIT_MAX_PER_HOUR=3
COOLDOWN_MINUTES=30
LOG_LEVEL=INFO

# Inbound SMS webhook (for self-service user setup)
WEBHOOK_ENABLED=true
WEBHOOK_PORT=8080

# OpenAI (required for AgentsSdkBrain — not needed for StubBrain)
OPENAI_API_KEY=sk-xxxxxxxx
